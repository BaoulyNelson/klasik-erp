# Frontend (Docker build)
VITE_API_URL=/api
VITE_SOURCE_DONNEES=api
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
VITE_FIREBASE_FIRESTORE_DATABASE_ID=

# Django production
DJANGO_SECRET_KEY=remplacer-par-une-cle-aleatoire-longue
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=erp.example.com
DJANGO_CORS_ALLOWED_ORIGINS=https://erp.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://erp.example.com
DJANGO_FRONTEND_URL=https://erp.example.com
DJANGO_GOOGLE_CLIENT_ID=
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_NUM_PROXIES=2
DJANGO_CACHE_BACKEND=database

# PostgreSQL
DB_ENGINE=postgresql
DB_NAME=klasik_erp
DB_USER=klasik_erp
DB_PASSWORD=remplacer-par-un-mot-de-passe-unique
DB_HOST=127.0.0.1
DB_PORT=5432

# SMTP
DJANGO_EMAIL_HOST=smtp.example.com
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_HOST_USER=
DJANGO_EMAIL_HOST_PASSWORD=
DJANGO_EMAIL_USE_TLS=true
DJANGO_EMAIL_USE_SSL=false
DJANGO_DEFAULT_FROM_EMAIL=noreply@example.com

# Host port for the Nginx frontend
FRONTEND_PORT=3000
